{
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "steps"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "target", "expected"],
        "properties": {
          "action": { "type": "string", "enum": ["TAP", "INPUT_TEXT", "PRESS_KEY", "WAIT", "ASSERT_TEXT_VISIBLE"] },
          "target": { "type": "string", "minLength": 1, "maxLength": 200 },
          "expected": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
